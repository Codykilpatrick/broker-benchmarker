{
  "title": "Redpanda Overview",
  "uid": "redpanda-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Kafka Bytes In (rate)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(redpanda_kafka_request_bytes_total{redpanda_request=\"produce\"}[30s])",
          "legendFormat": "produce bytes/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps" }
      }
    },
    {
      "id": 2,
      "title": "Kafka Bytes Out (rate)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(redpanda_kafka_request_bytes_total{redpanda_request=\"consume\"}[30s])",
          "legendFormat": "fetch bytes/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps" }
      }
    },
    {
      "id": 3,
      "title": "Request Latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, rate(redpanda_kafka_request_latency_seconds_bucket[30s]))",
          "legendFormat": "p50"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, rate(redpanda_kafka_request_latency_seconds_bucket[30s]))",
          "legendFormat": "p95"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, rate(redpanda_kafka_request_latency_seconds_bucket[30s]))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 4,
      "title": "CPU Busy",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(redpanda_cpu_busy_seconds_total[30s])",
          "legendFormat": "shard {{shard}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "max": 1 }
      }
    },
    {
      "id": 5,
      "title": "Memory Allocated",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "redpanda_memory_allocated_memory",
          "legendFormat": "allocated"
        },
        {
          "datasource": "Prometheus",
          "expr": "redpanda_memory_available_memory",
          "legendFormat": "available"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },
    {
      "id": 6,
      "title": "Disk Free",
      "type": "gauge",
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "redpanda_storage_disk_free_bytes / redpanda_storage_disk_total_bytes",
          "legendFormat": "disk free %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.2 },
              { "color": "green", "value": 0.4 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Under-Replicated Partitions",
      "type": "stat",
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "redpanda_kafka_under_replicated_replicas",
          "legendFormat": "under-replicated"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "title": "Kafka Requests/sec",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(redpanda_kafka_request_bytes_total[30s]) > 0",
          "legendFormat": "{{request}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "id": 9,
      "title": "Partitions & Topics",
      "type": "stat",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "redpanda_cluster_partitions",
          "legendFormat": "partitions"
        },
        {
          "datasource": "Prometheus",
          "expr": "redpanda_cluster_topics",
          "legendFormat": "topics"
        }
      ]
    },
    {
      "id": 10,
      "title": "Alert List",
      "type": "alertlist",
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 8 },
      "options": {
        "alertInstanceLabelFilter": "",
        "alertName": "",
        "dashboardAlerts": false,
        "groupBy": [],
        "groupMode": "default",
        "maxItems": 20,
        "sortOrder": 1,
        "stateFilter": {
          "error": true,
          "firing": true,
          "noData": false,
          "normal": true,
          "pending": true
        },
        "viewMode": "list"
      }
    }
  ]
}
